# PostgreSQL
DATABASE_URL="postgresql://centro:centro@localhost:5433/centro?schema=public"

# Auth.js / NextAuth (configured with the authentication feature)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (configured with the AI adaptation feature)
OPENAI_API_KEY=""
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_DAILY_LIMIT="20"

# Mock social platform adapters
MOCK_PLATFORMS="true"
MOCK_FAILURE_RATE="0"

# Scheduled publishing (configured in a future phase)
CRON_SECRET=""

# Local media storage (configured with uploads)
UPLOAD_DIR="./uploads"
